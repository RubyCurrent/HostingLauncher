<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B09"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERSION CENTER"
            android:textColor="#39FF14"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Версии Minecraft"
            android:textColor="#F2FFF7"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Устанавливай новые версии и создавай собственные игровые профили."
            android:textColor="#A5B8AA"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ОБЫЧНЫЕ ВЕРСИИ"
            android:textColor="#00D98B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/vanilla_profile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/create_profile_vanilla"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/optifine_profile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/create_profile_optifine"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOD LOADER"
            android:textColor="#00D98B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_fabric"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/modloader_dl_install_fabric"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_forge"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/modloader_dl_install_forge"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_neoforge"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/modloader_dl_install_neoforge"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_quilt"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/modloader_dl_install_quilt"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ДОПОЛНИТЕЛЬНО"
            android:textColor="#00D98B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_modpack"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/modpack_install_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_lwjgl3ify"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/create_lwjgl3ify_profile"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_bta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_cost_panel"
            android:text="@string/create_bta_profile"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>
</com.kdt.DefocusableScrollView>
